# Render Deployment Environment Variables
# These are automatically set by Render from render.yaml

# Backend Environment Variables
DATABASE_URL=<from-database-link>  # Auto-linked from skill-platform-db
SECRET_KEY=<auto-generated>  # Auto-generated by Render
REDIS_URL=  # Optional - not required for basic deployment
IGOT_API_URL=https://api.karmayogi.gov.in
APP_ENV=production
APP_DEBUG=false

# Frontend Environment Variables
VITE_API_URL=https://skill-platform-api.onrender.com  # Set after backend deploy
