# Database Configuration
# For PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skill_platform
# For SQLite (default if DATABASE_URL is empty):
# DATABASE_URL=

# Security
SECRET_KEY=your-secret-key-change-in-production-use-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# iGOT Karmayogi Integration
IGOT_API_URL=https://api.karmayogi.gov.in
IGOT_API_KEY=

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# ML Model Settings
# Set to 'cpu' or 'cuda' depending on your hardware
MODEL_DEVICE=cpu

# Application Settings
APP_ENV=development
DEBUG=true
